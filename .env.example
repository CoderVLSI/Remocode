# Optional. Copy to `.env` for development builds. EXPO_PUBLIC_* values are bundled into the app,
# so only put values here that are safe to ship in a client.
#
# Without this, the app asks for your Convex deployment URL on the sign-in screen, so a prebuilt
# APK works with your own backend and no rebuild is needed.
EXPO_PUBLIC_CONVEX_URL=https://YOUR-DEPLOYMENT.convex.cloud

# Optional: Google connector (Drive / Docs / Sheets / Calendar, read-only).
# Create OAuth clients of type "Android" and/or "iOS" in Google Cloud Console.
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
