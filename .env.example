# Copy to `.env` (or set as EAS secrets). EXPO_PUBLIC_* values are bundled into the
# app, so only put values here that are safe to ship in a client (the Supabase
# anon key is designed for this; never put a service-role key here).

# Supabase project (Settings -> API)
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Optional: Google connector (Drive / Docs / Sheets / Calendar, read-only).
# Create OAuth clients of type "Android" and/or "iOS" in Google Cloud Console.
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# Optional: must match "Email OTP Length" in Supabase (Auth -> Providers -> Email). Default 6.
EXPO_PUBLIC_OTP_LENGTH=6
